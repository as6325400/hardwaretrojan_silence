digraph golden {
  rankdir=TB;
  splines=ortho;
  nodesep=0.4;
  ranksep=0.5;
  node [fontname="Helvetica" fontsize=10];
  edge [fontsize=8];

  // Title
  labelloc="t";
  label="Golden Circuit";
  fontsize=14;
  fontname="Helvetica-Bold";

  // PI nodes
  { rank=same;
    a [shape=invtriangle label="a" style=filled fillcolor="#dae8fc" width=0.4 height=0.3];
    b [shape=invtriangle label="b" style=filled fillcolor="#dae8fc" width=0.4 height=0.3];
    c [shape=invtriangle label="c" style=filled fillcolor="#dae8fc" width=0.4 height=0.3];
    d [shape=invtriangle label="d" style=filled fillcolor="#dae8fc" width=0.4 height=0.3];
  }

  // NOT gates
  n1 [shape=triangle label="NOT" style=filled fillcolor="#f5f5f5" width=0.5 height=0.3 orientation=180];
  n2 [shape=triangle label="NOT" style=filled fillcolor="#f5f5f5" width=0.5 height=0.3 orientation=180];

  // AND gates (majority)
  g1 [shape=box label="AND\ng1" style="filled,rounded" fillcolor="#d5e8d4" width=0.5 height=0.4];
  g2 [shape=box label="AND\ng2" style="filled,rounded" fillcolor="#d5e8d4" width=0.5 height=0.4];
  g3 [shape=box label="AND\ng3" style="filled,rounded" fillcolor="#d5e8d4" width=0.5 height=0.4];

  // OR gates (majority)
  g4 [shape=box label="OR\ng4" style="filled,rounded" fillcolor="#fff2cc" width=0.5 height=0.4];
  
  // AND gates (XOR decomposition)
  x1 [shape=box label="AND\nx1" style="filled,rounded" fillcolor="#d5e8d4" width=0.5 height=0.4];
  x2 [shape=box label="AND\nx2" style="filled,rounded" fillcolor="#d5e8d4" width=0.5 height=0.4];

  // OR gates
  Y1 [shape=box label="OR\nY1" style="filled,rounded" fillcolor="#fff2cc" width=0.5 height=0.4];
  Y2 [shape=box label="OR\nY2" style="filled,rounded" fillcolor="#fff2cc" width=0.5 height=0.4];

  // PO
  { rank=same;
    PO_Y1 [shape=triangle label="Y1" style=filled fillcolor="#f8cecc" width=0.4 height=0.3];
    PO_Y2 [shape=triangle label="Y2" style=filled fillcolor="#f8cecc" width=0.4 height=0.3];
  }

  // Connections - majority(a,b,c)
  a -> g1;
  b -> g1;
  b -> g2;
  c -> g2;
  a -> g3;
  c -> g3;
  g1 -> g4;
  g2 -> g4;
  g4 -> Y1;
  g3 -> Y1;
  Y1 -> PO_Y1;

  // Connections - a XOR d
  a -> n1;      // NOT a
  d -> n2;      // NOT d
  a -> x1;
  n2 -> x1;    // AND(a, NOT d)
  n1 -> x2;
  d -> x2;     // AND(NOT a, d)
  x1 -> Y2;
  x2 -> Y2;
  Y2 -> PO_Y2;
}
