digraph trojan {
  rankdir=TB;
  splines=ortho;
  nodesep=0.35;
  ranksep=0.45;
  node [fontname="Helvetica" fontsize=9];
  edge [fontsize=7];

  labelloc="t";
  label="Trojan Circuit (red = trojan additions)";
  fontsize=14;
  fontname="Helvetica-Bold";

  // PI
  { rank=same;
    a [shape=invtriangle label="a" style=filled fillcolor="#dae8fc" width=0.35 height=0.25];
    b [shape=invtriangle label="b" style=filled fillcolor="#dae8fc" width=0.35 height=0.25];
    c [shape=invtriangle label="c" style=filled fillcolor="#dae8fc" width=0.35 height=0.25];
    d [shape=invtriangle label="d" style=filled fillcolor="#dae8fc" width=0.35 height=0.25];
  }

  // === GOLDEN PART (green/yellow) ===
  n1 [shape=triangle label="NOT" style=filled fillcolor="#f5f5f5" width=0.4 height=0.25 orientation=180];
  n2 [shape=triangle label="NOT" style=filled fillcolor="#f5f5f5" width=0.4 height=0.25 orientation=180];
  g1 [shape=box label="AND\ng1" style="filled,rounded" fillcolor="#d5e8d4" width=0.45 height=0.35];
  g2 [shape=box label="AND\ng2" style="filled,rounded" fillcolor="#d5e8d4" width=0.45 height=0.35];
  g3 [shape=box label="AND\ng3" style="filled,rounded" fillcolor="#d5e8d4" width=0.45 height=0.35];
  g4 [shape=box label="OR\ng4" style="filled,rounded" fillcolor="#fff2cc" width=0.45 height=0.35];
  Y1_orig [shape=box label="OR\nY1" style="filled,rounded" fillcolor="#fff2cc" width=0.45 height=0.35];
  x1 [shape=box label="AND\nx1" style="filled,rounded" fillcolor="#d5e8d4" width=0.45 height=0.35];
  x2 [shape=box label="AND\nx2" style="filled,rounded" fillcolor="#d5e8d4" width=0.45 height=0.35];
  Y2 [shape=box label="OR\nY2" style="filled,rounded" fillcolor="#fff2cc" width=0.45 height=0.35];

  // === TROJAN PART (red) ===
  na [shape=triangle label="NOT" style=filled fillcolor="#f8cecc" width=0.4 height=0.25 orientation=180];
  nb [shape=triangle label="NOT" style=filled fillcolor="#f8cecc" width=0.4 height=0.25 orientation=180];
  nc [shape=triangle label="NOT" style=filled fillcolor="#f8cecc" width=0.4 height=0.25 orientation=180];
  nd [shape=triangle label="NOT" style=filled fillcolor="#f8cecc" width=0.4 height=0.25 orientation=180];
  p1 [shape=box label="AND\np1" style="filled,rounded" fillcolor="#f8cecc" width=0.45 height=0.35];
  p2 [shape=box label="AND\np2" style="filled,rounded" fillcolor="#f8cecc" width=0.45 height=0.35];
  t1 [shape=box label="OR\nt1=a⊕b" style="filled,rounded" fillcolor="#f8cecc" width=0.55 height=0.35];
  p3 [shape=box label="AND\np3" style="filled,rounded" fillcolor="#f8cecc" width=0.45 height=0.35];
  p4 [shape=box label="AND\np4" style="filled,rounded" fillcolor="#f8cecc" width=0.45 height=0.35];
  t2 [shape=box label="OR\nt2=c⊕d" style="filled,rounded" fillcolor="#f8cecc" width=0.55 height=0.35];
  t3 [shape=box label="AND\nt3\ntrigger" style="filled,rounded" fillcolor="#ff0000" fontcolor=white width=0.55 height=0.4];
  nt3 [shape=triangle label="NOT" style=filled fillcolor="#f8cecc" width=0.4 height=0.25 orientation=180];
  nY1 [shape=triangle label="NOT" style=filled fillcolor="#f8cecc" width=0.4 height=0.25 orientation=180];
  m1 [shape=box label="AND\nm1" style="filled,rounded" fillcolor="#f8cecc" width=0.45 height=0.35];
  m2 [shape=box label="AND\nm2" style="filled,rounded" fillcolor="#f8cecc" width=0.45 height=0.35];
  Y1_new [shape=box label="OR\nY1'" style="filled,rounded" fillcolor="#ff0000" fontcolor=white width=0.5 height=0.35];

  // PO
  { rank=same;
    PO_Y1 [shape=triangle label="Y1'" style=filled fillcolor="#f8cecc" width=0.35 height=0.25];
    PO_Y2 [shape=triangle label="Y2'" style=filled fillcolor="#dae8fc" width=0.35 height=0.25];
  }

  // Golden connections
  a -> g1; b -> g1;
  b -> g2; c -> g2;
  a -> g3; c -> g3;
  g1 -> g4; g2 -> g4;
  g4 -> Y1_orig; g3 -> Y1_orig;
  a -> n1; d -> n2;
  a -> x1; n2 -> x1;
  n1 -> x2; d -> x2;
  x1 -> Y2; x2 -> Y2;
  Y2 -> PO_Y2;

  // Trojan trigger connections
  a -> na; b -> nb; c -> nc; d -> nd;
  a -> p1; nb -> p1;   // AND(a, NOT b)
  na -> p2; b -> p2;   // AND(NOT a, b)
  p1 -> t1; p2 -> t1;  // OR = a XOR b
  c -> p3; nd -> p3;   // AND(c, NOT d)
  nc -> p4; d -> p4;   // AND(NOT c, d)
  p3 -> t2; p4 -> t2;  // OR = c XOR d
  t1 -> t3; t2 -> t3;  // AND = trigger

  // Trojan payload connections
  t3 -> nt3;             // NOT trigger
  Y1_orig -> nY1;        // NOT Y1
  Y1_orig -> m1; nt3 -> m1;  // AND(Y1, NOT trigger)
  nY1 -> m2; t3 -> m2;       // AND(NOT Y1, trigger)
  m1 -> Y1_new; m2 -> Y1_new; // OR = Y1 XOR trigger
  Y1_new -> PO_Y1;

  // Trojan edges in red
  edge [color=red];
}
